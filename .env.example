# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required for production collection, token, and listing persistence.
# Use the Supabase Postgres connection string intended for your server runtime.
DATABASE_URL=""

# Production server settings (the host should provide PORT).
NODE_ENV="production"
PORT="3000"

# Optional: index non-sequential ERC-721 token IDs and transfers on Polygon.
# Etherscan API V2 uses the same key for PolygonScan (chainid=137).
POLYGONSCAN_API_KEY=""

# Optional marketplace indexer refresh credentials. These refresh cached views;
# the on-chain tokenURI and contract owner permissions remain authoritative.
OPENSEA_API_KEY=""
THIRDWEB_CLIENT_ID=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
